rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if false;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'predictionsLimit', 'predictionsUsed']);
    }

    match /users/{uid}/predictions/{predId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.predictionsUsed
           < get(/databases/$(database)/documents/users/$(uid)).data.predictionsLimit;
      allow update, delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
  }
}